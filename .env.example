PUBLIC_CUSTOMER_IO_SITE_ID=your-customer-io-site-id

# Server-only intake; default disabled. Never use PUBLIC_ prefixes for credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WEBSITE_INTAKE_ENABLED=false
WEBSITE_INTAKE_TEST_ONLY=true

# Set true only for the approved production build. Preview remains noindex.
PUBLIC_SITE_INDEXABLE=false
