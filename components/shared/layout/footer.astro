---
import { site } from '@/data/site';
---

<footer class="border-t border-line bg-ink-2 py-16">
  <div class="shell flex flex-wrap items-center justify-between gap-8">
    <a href="/" class="font-display text-3xl font-bold">
      Zia<span class="text-signal">Flow</span>
    </a>
    <p class="max-w-md text-mute">Local SEO, automation playbooks, CRO, and case studies for Arizona businesses.</p>
    <a href={site.cta.primary.href} class="underline underline-offset-4">
      Contact ZiaFlow ↗
    </a>
    <nav aria-label="Footer" class="flex w-full flex-wrap gap-6">
      <a href="https://ziaflow.com/services/automation">Automation</a>
      <a href="https://ziaflow.com/services/seo">SEO</a>
      <a href="https://ziaflow.com/services/ppc">PPC Management</a>
      <a href="https://ziaflow.com/services/web-development">Web Development</a>
      <a href="https://ziaflow.com/services/ecommerce">Ecommerce</a>
      <a href="https://ziaflow.com/blog">Blog</a>
      <a href="https://ziaflow.com/about">About</a>
      <a href="https://ziaflow.com/contact">Contact ZiaFlow</a>
      <a href="https://ziaflow.com/terms">Terms</a>
      <a href="https://ziaflow.com/privacy">Privacy Policy</a>
    </nav>
    <p class="w-full text-sm text-mute">© {new Date().getFullYear()} ZiaFlow</p>
  </div>
</footer>
