---
import { site } from '@/data/site';
---

<footer class="border-t border-line bg-ink-2 py-16">
  <div class="shell flex flex-wrap items-center justify-between gap-8">
    <a href="/" class="font-display text-3xl font-bold">
      Zia<span class="text-signal">Flow</span>
    </a>
    <p class="max-w-md text-mute">A clearer process for every inquiry, owner and next action.</p>
    <a href={site.cta.primary.href} class="underline underline-offset-4">
      Talk through your lead flow ↗
    </a>
    <p class="w-full text-sm text-mute">© {new Date().getFullYear()} ZiaFlow</p>
  </div>
</footer>
