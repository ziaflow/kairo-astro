---
import Button from '@/components/shared/ui/button.astro';
import { hero } from '@/data/home';
import { site } from '@/data/site';
---

<section class="relative isolate min-h-[100dvh] overflow-hidden" data-hero aria-labelledby="hero-title">
  <canvas class="absolute inset-0 -z-10 size-full" data-signal-field aria-hidden="true"></canvas>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-2/5 bg-gradient-to-t from-ink via-ink/70 to-transparent"
    aria-hidden="true"></div>

  <div class="shell flex min-h-[100dvh] flex-col justify-end pt-32 pb-12 md:pb-16" data-hero-sink>
    <p class="mb-8 font-mono text-label text-signal uppercase" data-intro>Phoenix, Arizona · Serving nationwide</p>
    <h1 id="hero-title" class="font-display text-hero font-extrabold text-bone">
      {hero.lines.map((line) => (
        <span class="block overflow-hidden pb-[0.06em]" data-hero-line>
          <span class="block">
            {line.accent ? `${line.text} ` : line.text}
            {line.accent && <span class="text-signal">{line.accent}</span>}
          </span>
        </span>
      ))}
    </h1>
    <div class="mt-10 grid gap-8 md:grid-cols-12 md:items-end">
      <div class="flex flex-col gap-8 md:col-span-6 md:col-start-7 lg:col-span-5 lg:col-start-8">
      <p class="max-w-[36ch] text-lead text-mute" data-intro>
        {hero.intro}
      </p>
      <div class="flex flex-wrap items-center gap-3" data-intro>
        <Button label={site.cta.primary.label} href={site.cta.primary.href} class="h-13 px-7" />
        <Button
          label={site.cta.secondary.label}
          href={site.cta.secondary.href}
          variant="outline"
          icon={false}
          class="h-13 px-7"
        />
      </div>
      </div>
    </div>
  </div>
</section>
