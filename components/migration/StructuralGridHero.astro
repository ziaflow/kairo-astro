---
import Button from '@/components/shared/ui/button.astro';
---

<section class="shell hero">
  <h1>
    Engineering the Future |<br />
    Custom Software &amp; AI Solutions
    <br />
    <span>That Power Growth</span>
  </h1>
  <p class="max-w-2xl text-lead">
    Deploy autonomous AI agents, AI voice assistants, and enterprise-grade web applications. We build the
    technology that scales Arizona businesses.
  </p>
  <img class="mt-10 aspect-[16/7] w-full rounded-2xl object-cover" src="/images/phoenix-skyline.jpg" alt="Phoenix skyline at sunset" width="1600" height="700" fetchpriority="high" />
  <div class="actions">
    <Button label="📞 (602) 834-4239" href="tel:+16028344239" />
    <Button
      label="Book Tech Consult"
      href="https://outlook.office.com/book/ZiaFlowIntake@ziaflow.com/?ismsaljsauthenabled"
      variant="outline"
    />
    <Button label="Automate Front Desk" href="/contact" variant="outline" />
  </div>

</section>
