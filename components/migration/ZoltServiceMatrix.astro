---
import Button from '@/components/shared/ui/button.astro';
import { services as servicePages } from '@/data/services';
const featuredSlugs = ['web-development', 'automation', 'seo', 'ppc', 'cro', 'cloud'];
const services = featuredSlugs.map((slug) => servicePages.find((service) => service.slug === slug)!);
---

<section class="shell" id="services">
  <header class="section-head">
    <p class="eyebrow">Services for Arizona businesses</p>
    <h2>Improve the next step in your customer journey.</h2>
    <p>Choose the work that addresses your current bottleneck, from a clearer website to more reliable follow-up.</p>
  </header>
  <div class="cards">
    {services.map((s) => (
      <article class="card" id={s.slug}>
        <p class="eyebrow">{s.tagline}</p>
        <h3>{s.name}</h3>
        <p>{s.meta.description}</p>
        <ul>
          {s.features.map((h) => (
            <li>{h.title}</li>
          ))}
        </ul>
        <a href={`/services/${s.slug}`}>Explore {s.name}</a>
      </article>
    ))}
  </div>
  <div class="card mt-10">
    <h3>Not sure where to start?</h3>
    <p>
      Tell us what happens today and what you want to improve. We will discuss whether a focused project or a separately
      scoped assessment is the right next step.
    </p>
    <div class="actions">
      <Button label="Discuss your project" href="/contact" />
    </div>
  </div>
</section>
