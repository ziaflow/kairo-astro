---
import { getCollection } from 'astro:content';
import PageHero from '@/components/shared/page-hero.astro';
import Layout from '@/layouts/layout.astro';
import { pageTitle } from '@/utils/generate-meta-data';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Layout
  title={pageTitle('Digital Marketing Insights')}
  description="Articles on automation, SEO, conversion optimization, local advertising, and web development from ZiaFlow.">
  <PageHero
    lines={['Digital growth,', 'made useful.']}
    accent={1}
    intro="Practical guidance on automation, search, conversion, local advertising, and the systems that turn attention into revenue."
  />
  <section class="border-t border-line" aria-labelledby="blog-posts">
    <div class="shell py-24 md:py-32">
      <h2 id="blog-posts" class="font-display text-title font-bold text-bone" data-split>Latest insights.</h2>
      <div class="mt-14 divide-y divide-line border-y border-line">
        {posts.map((post) => (
          <a
            href={`/${post.id}`}
            class="group grid gap-4 py-8 md:grid-cols-12 md:items-center md:py-10"
            data-reveal>
            <p class="font-mono text-label text-signal uppercase md:col-span-2">
              {post.data.category ?? 'Insights'}
            </p>
            <h3 class="font-display text-2xl font-bold text-bone group-hover:text-signal md:col-span-7 md:text-3xl">
              {post.data.title}
            </h3>
            <time class="text-sm text-mute md:col-span-2 md:text-right" datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            <span class="text-right text-signal md:col-span-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
