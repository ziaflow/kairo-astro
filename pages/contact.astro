---
import Button from '@/components/shared/ui/button.astro';
import PageHero from '@/components/shared/page-hero.astro';
import { bookingUrl } from '@/data/services';
import Layout from '@/layouts/layout.astro';
import { pageTitle } from '@/utils/generate-meta-data';

const field =
  'h-13 w-full rounded-none border-0 border-b border-line-strong bg-transparent px-0 text-bone placeholder:text-dim transition-colors duration-300 focus:border-bone focus:outline-none';
---

<Layout
  title={pageTitle('Contact Our Phoenix Digital Agency')}
  description="Get in touch with ZiaFlow. Call (602) 834-4239 or schedule a free consultation for custom development, automation, and digital marketing solutions.">
  <PageHero
    lines={['Contact the', 'ZiaFlow team.']}
    accent={1}
    intro="Ready to transform your business? Call us directly for immediate assistance or send us your project details by email.">
    <div class="flex flex-wrap gap-3 md:col-span-5 md:col-start-2" data-intro>
      <Button label="Call (602) 834-4239" href="tel:+16028344239" />
      <Button label="Book consultation" href={bookingUrl} variant="outline" />
    </div>
  </PageHero>

  <section class="border-t border-line" aria-labelledby="contact-options">
    <div class="shell py-24 md:py-32">
      <h2 id="contact-options" class="max-w-[12ch] font-display text-title font-bold text-bone" data-split>
        Start your digital transformation.
      </h2>
      <p class="mt-6 max-w-[48ch] text-lead text-mute">
        Tell us about your project and we will get back to you within 24 hours. Whether you need custom development,
        automation, or marketing solutions, our team is ready to help.
      </p>
      <div class="mt-14 grid border-t border-l border-line md:grid-cols-3">
        <a href="mailto:info@ziaflow.com" class="group min-h-64 border-r border-b border-line p-8 hover:bg-ink-2">
          <p class="font-mono text-label text-signal uppercase">Email</p>
          <h3 class="mt-10 font-display text-2xl font-bold text-bone">info@ziaflow.com</h3>
          <p class="mt-4 text-mute">Share your goals, current challenges, and any useful project details.</p>
        </a>
        <a href="tel:+16028344239" class="group min-h-64 border-r border-b border-line p-8 hover:bg-ink-2">
          <p class="font-mono text-label text-signal uppercase">Phone</p>
          <h3 class="mt-10 font-display text-2xl font-bold text-bone">(602) 834-4239</h3>
          <p class="mt-4 text-mute">Direct line for new project inquiries and existing client support.</p>
        </a>
        <a href={bookingUrl} class="group min-h-64 border-r border-b border-line p-8 hover:bg-ink-2">
          <p class="font-mono text-label text-signal uppercase">Schedule</p>
          <h3 class="mt-10 font-display text-2xl font-bold text-bone">Book a consultation</h3>
          <p class="mt-4 text-mute">Choose a time for a straightforward discovery call with no sales pressure.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-ink-2" aria-labelledby="contact-form-title">
    <div class="shell grid gap-14 py-24 md:py-32 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="font-mono text-label text-signal uppercase">Project inquiry</p>
        <h2 id="contact-form-title" class="mt-4 max-w-[12ch] font-display text-title font-bold text-bone" data-split>
          Tell us what needs to work better.
        </h2>
        <p class="mt-6 max-w-[42ch] text-mute">
          Share the goal, the bottleneck, and the best way to reach you. Use this form to send your project details, or
          call us directly.
        </p>
      </div>

      <form action="/api/contact" method="post" class="lg:col-span-6 lg:col-start-7" data-contact-form>
        <input type="hidden" name="form_name" value="contact" />
        <input class="hidden" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="grid gap-x-6 gap-y-8 md:grid-cols-2">
          <label class="flex flex-col gap-2 text-sm text-bone">
            Full name
            <input class={field} name="name" autocomplete="name" placeholder="Your name" required />
          </label>
          <label class="flex flex-col gap-2 text-sm text-bone">
            Work email
            <input
              class={field}
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@company.com"
              required
            />
          </label>
          <label class="flex flex-col gap-2 text-sm text-bone">
            Phone
            <input class={field} name="phone" type="tel" autocomplete="tel" placeholder="(602) 555-0100" />
          </label>
          <label class="flex flex-col gap-2 text-sm text-bone">
            What can we help with?
            <select class={`${field} appearance-none bg-ink-2`} name="service_interest" required>
              <option value="general">General inquiry</option>
              <option value="web">Website or software</option>
              <option value="automation">Automation or AI</option>
            </select>
          </label>
          <label class="flex flex-col gap-2 text-sm text-bone md:col-span-2">
            Project details
            <textarea
              class={`${field} h-auto resize-y py-3`}
              name="message"
              rows="4"
              placeholder="What are you trying to improve?"
              required></textarea>
          </label>
        </div>
        <div class="mt-10 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <button type="submit" class="btn group h-14 bg-signal px-8 text-ink disabled:opacity-70" data-contact-submit>
            Send project details
          </button>
          <p class="max-w-[34ch] text-sm text-mute">
            We use these details to respond to your inquiry. This does not subscribe you to marketing emails. See our{' '}
            <a class="underline" href="/privacy">
              privacy policy
            </a>
            .
          </p>
        </div>
        <p class="mt-5 min-h-6 text-sm" role="status" aria-live="polite" data-contact-status></p>
      </form>
    </div>
  </section>
</Layout>
