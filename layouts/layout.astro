---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import Footer from '@/components/shared/layout/footer.astro';
import Loader from '@/components/shared/layout/loader.astro';
import Menu from '@/components/shared/layout/menu.astro';
import Navbar from '@/components/shared/layout/navbar.astro';
import Transition from '@/components/shared/layout/transition.astro';
import ViewChip from '@/components/shared/layout/view-chip.astro';
import { site } from '@/data/site';
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE, SITE_NAME } from '@/utils/generate-meta-data';

const accentVars = `:root{--color-signal:${site.accent};--color-signal-soft:color-mix(in srgb, ${site.accent} 14%, transparent);}`;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  preloader?: boolean;
  noindex?: boolean;
}

const { title = DEFAULT_TITLE, description = DEFAULT_DESCRIPTION, image, preloader = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/images/og-image.jpg', Astro.site);
const customerIoSiteId = import.meta.env.PUBLIC_CUSTOMER_IO_SITE_ID;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  email: site.email,
  telephone: '+1-602-834-4239',
  address: { '@type': 'PostalAddress', addressLocality: 'Phoenix', addressRegion: 'AZ', addressCountry: 'US' },
  areaServed: { '@type': 'Country', name: 'United States' },
  sameAs: site.socials.map(({ href }) => href),
};
---

<!doctype html>
<html lang="en" data-preloader={preloader ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta name="google-site-verification" content="orcPxI47GSa-cRvY11tUe6iGg2IO_RPvnA1q95iEM3M" />
    <meta name="theme-color" content="#0b0c0b" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <style is:inline set:html={accentVars}></style>
    <Font cssVariable="--font-display-face" preload />
    <Font cssVariable="--font-body-face" preload />
    <Font cssVariable="--font-mono-face" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('js');
        try {
          if (sessionStorage.getItem('kairo:transition')) root.classList.add('is-arriving');
          else if (root.hasAttribute('data-preloader')) root.classList.add('is-loading');
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      html.is-loading [data-loader] {
        display: block;
      }
      html.is-loading [data-nav] [data-logo-mark] {
        opacity: 0;
      }
      html.is-arriving [data-transition] {
        visibility: visible;
      }
      [data-transition-col] {
        transform: translateY(101%);
      }
      html.is-arriving [data-transition-col] {
        transform: none;
      }
      .js [data-intro] {
        opacity: 0;
      }
      .js [data-hero-line] > * {
        transform: translateY(110%);
      }
      .js [data-split],
      .js [data-words] {
        visibility: hidden;
      }
      .js [data-reveal] {
        opacity: 0;
        transform: translateY(2.5rem);
      }
      .js [data-reveal-media] {
        clip-path: inset(100% 0 0 0);
      }
      .js [data-nav-item] {
        opacity: 0;
      }
      .js [data-product-tile] {
        opacity: 0;
      }
      .js [data-product-hero] {
        opacity: 0;
      }
    </style>
  </head>
  <body>
    <a
      href="#main"
      class="fixed top-3 left-3 z-[110] -translate-y-24 rounded-full bg-bone px-4 py-2 text-sm text-ink focus:translate-y-0">
      Skip to content
    </a>
    {preloader && <Loader />}
    <Transition />
    <Navbar />
    <Menu />
    <ViewChip />
    <div class="relative z-10 bg-ink" data-page>
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer />
    {
      customerIoSiteId && (
        <script is:inline define:vars={{ customerIoSiteId }}>
          var _cio = window._cio = window._cio || [];
          (function () {
            var factory = function (method) {
              return function () {
                _cio.push([method].concat(Array.prototype.slice.call(arguments)));
              };
            };
            ['load', 'identify', 'sidentify', 'track', 'page', 'on', 'off'].forEach(function (method) {
              _cio[method] = factory(method);
            });
            var tracker = document.createElement('script');
            var firstScript = document.getElementsByTagName('script')[0];
            tracker.async = true;
            tracker.id = 'cio-tracker';
            tracker.setAttribute('data-site-id', customerIoSiteId);
            tracker.setAttribute('data-use-array-params', 'true');
            tracker.src = 'https://assets.customer.io/assets/track.js';
            firstScript.parentNode.insertBefore(tracker, firstScript);
          })();
        </script>
      )
    }
    <script>
      import '@/components/animation/main';
    </script>
  </body>
</html>
